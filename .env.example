# Copy to .env and fill in. Never commit the real .env (it's gitignored).
# See AppConfig.kt / application.conf for how these are read.

# --- Server ---
PORT=8080

# --- MongoDB (required) ---
MONGO_URI=mongodb://localhost:27017

# --- WhatsApp Cloud API (required) ---
# Meta Developer Dashboard > your app > WhatsApp > API Setup
WA_VERIFY_TOKEN=choose-any-random-string
WA_APP_SECRET=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# WhatsApp Embedded Signup (optional — public values used by the backoffice JS SDK).
# Leave blank to disable embedded signup; manual number binding still works.
WHATSAPP_APP_ID=
WA_ES_CONFIG_ID=

# --- Instagram Login OAuth onboarding (optional) ---
# Separate Instagram app id/secret, NOT the WhatsApp app secret above.
# Leave blank to disable self-serve Instagram connect; manual channel binding still works.
IG_APP_ID=
IG_APP_SECRET=
IG_OAUTH_REDIRECT=

# --- OpenRouter (required) ---
OPENROUTER_API_KEY=
# Defaults shown below are used if unset.
OPENROUTER_PRIMARY_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-001

# --- PDF storage ---
# Defaults to ./data/pdfs locally; the prod compose file overrides this to /data/pdfs (mounted volume).
PDF_STORAGE_PATH=./data/pdfs

# --- Admin / dashboard auth ---
ADMIN_JWT_SECRET=choose-a-long-random-string
# Backoffice sign-in with Google (Firebase Auth, project "thebotslab"). The web values are public;
# only the comma-separated ADMIN_EMAILS may sign in. Get them with:
#   firebase apps:sdkconfig WEB --project thebotslab
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
ADMIN_EMAILS=
# Optional password login (leave empty to turn it off): bcrypt hash of the backoffice admin
# password — do NOT put a plaintext password here. Generate one, e.g.:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 12 "" 'your-password' | cut -d: -f2 | tr -d '\n'
ADMIN_PASSWORD_HASH=

# --- Agents (automations) runtime (optional; defaults shown) ---
# How often the scheduler fires schedules, sweeps dates and resumes waiting runs (5-600 seconds).
AGENTS_TICK_SECONDS=30
# Workers for agent runs, separate from the customer chat lanes (1-32).
AGENTS_LANES=4
# Runs one company may have working at the same time (1-16).
AGENTS_MAX_CONCURRENT_RUNS_PER_COMPANY=2

# --- Google / Gmail integration (optional) ---
# A Google OAuth client of type "Web application" for connecting a company's Gmail account,
# separate from the Firebase sign-in above. Authorized redirect URI:
#   https://<host>/integrations/google/callback
# Leave blank to turn the integration off. The backoffice's Platform settings > Google can set
# these three instead. Setup and Google verification: docs/google-oauth-verification.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=
# Encrypts the Google tokens at rest (AES-256-GCM). Env only, and needed to connect accounts.
# Generate it with:  openssl rand -base64 32
# Back it up: without it, every connected account has to be connected again. To rotate, put the
# new key first and keep the old one after a comma; each account moves to the new key at its next
# token refresh.
INTEGRATIONS_ENCRYPTION_KEY=
# Lets companies turn on "Use my inbox in automations" (Gmail's restricted read scopes). Keep it
# false until Google verified those scopes and the CASA assessment passed. Read at startup.
GMAIL_INBOX_ENABLED=false
# How often connected inboxes are checked for new mail (15-3600 seconds).
GMAIL_SYNC_SECONDS=60
# Reserved for Gmail push through Pub/Sub; not used yet, connected inboxes are polled.
GMAIL_PUBSUB_TOPIC=
